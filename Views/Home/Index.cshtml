@{
    ViewData["Title"] = "ERP Dashboard";
}

<div class="text-center mb-5">
    <h1 class="display-4">Stock ERP</h1>
    <p class="lead">Willkommen zur Lagerbestandssoftware.</p>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-white card-blue h-100">
            <div class="card-body">
                <h5 class="card-title">Produkte</h5>
                <p class="card-text display-6">@ViewBag.ProductCount</p>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between">
                <a class="small text-white stretched-link" asp-controller="Products" asp-action="Index">Details anzeigen</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white card-green h-100">
            <div class="card-body">
                <h5 class="card-title">Kunden</h5>
                <p class="card-text display-6">@ViewBag.CustomerCount</p>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between">
                <a class="small text-white stretched-link" asp-controller="Customers" asp-action="Index">Details anzeigen</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white card-orange h-100">
            <div class="card-body">
                <h5 class="card-title">Niedriger Bestand</h5>
                <p class="card-text display-6">@ViewBag.LowStockCount</p>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between">
                <a class="small text-white stretched-link" asp-controller="Products" asp-action="Index">Prüfen</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white card-cyan h-100">
            <div class="card-body">
                <h5 class="card-title">Lagerwert</h5>
                <p class="card-text display-6">CHF @ViewBag.TotalValue.ToString("N2")</p>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="row mt-4">
    <div class="col-md-6">
        <div class="list-group">
            <a href="#" class="list-group-item list-group-item-action active" aria-current="true">
                Schnellzugriff
            </a>
            <a asp-controller="Categories" asp-action="Index" class="list-group-item list-group-item-action">Kategorien verwalten</a>
            <a asp-controller="Suppliers" asp-action="Index" class="list-group-item list-group-item-action">Lieferanten verwalten</a>
        </div>
    </div>
</div>
