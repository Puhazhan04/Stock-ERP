@model StockERP.Models.Customer
@{ ViewData["Title"] = "Kunde löschen"; }
<h1 class="text-danger">Kunde löschen</h1>
<div class="alert alert-warning">
    <h3>Möchtest du diesen Kunden wirklich löschen?</h3>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Löschen" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
    </form>
</div>
