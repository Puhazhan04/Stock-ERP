@model IEnumerable<StockERP.Models.Customer>
@{ ViewData["Title"] = "Kunden"; }
<h1>Kunden</h1>
<p><a asp-action="Create" class="btn btn-primary">Neuer Kunde</a></p>
<table class="table">
    <thead><tr><th>Vorname</th><th>Nachname</th><th>Email</th><th>Aktionen</th></tr></thead>
    <tbody>
@foreach (var item in Model) {
        <tr><td>@item.FirstName</td><td>@item.LastName</td><td>@item.Email</td>
            <td>
                <div class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Bearbeiten</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Löschen</a>
                </div>
            </td>
        </tr>}
    </tbody>
</table>
