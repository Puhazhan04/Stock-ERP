@model SimpleERP.Models.Supplier
@{ ViewData["Title"] = "Lieferant löschen"; }
<h1 class="text-danger">Lieferant löschen</h1>
<div class="alert alert-warning">
    <h3>Möchtest du diesen Lieferanten wirklich löschen?</h3>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Kontakt</dt><dd class="col-sm-9">@Model.ContactPerson</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Löschen" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
    </form>
</div>
