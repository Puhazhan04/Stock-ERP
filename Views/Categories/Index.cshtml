@model IEnumerable<StockERP.Models.Category>
@{ ViewData["Title"] = "Kategorien"; }
<h1>Kategorien</h1>
<p><a asp-action="Create" class="btn btn-primary">Neue Kategorie</a></p>
<table class="table">
    <thead><tr><th>Name</th><th>Aktionen</th></tr></thead>
    <tbody>
@foreach (var item in Model) {
        <tr><td>@item.Name</td>
            <td>
                <div class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Bearbeiten</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Löschen</a>
                </div>
            </td>
        </tr>}
    </tbody>
</table>
