@model StockERP.Models.Product

@{
    ViewData["Title"] = "Produkt löschen";
}

<h1 class="text-danger">Produkt löschen</h1>

<div class="alert alert-warning">
    <h3>Möchtest du dieses Produkt wirklich löschen?</h3>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
        
        <dt class = "col-sm-3">Preis (CHF)</dt>
        <dd class = "col-sm-9">CHF @Model.Price.ToString("F2")</dd>
        
        <dt class = "col-sm-3">@Html.DisplayNameFor(model => model.Stock)</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.Stock)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Endgültig Löschen" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
    </form>
</div>
